<style>

  .cadastro-page {
    background: #f5f7fa;
  }

  .cadastro-hero {
    padding: 64px 0 52px;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .cadastro-hero h1 {
    margin: 10px 0 12px;
    font-size: 42px;
  }

  .cadastro-hero p {
    max-width: 700px;
    font-size: 18px;
    line-height: 1.6;
  }

  .cadastro-tag {
    display: inline-block;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 1px;
  }

  .cadastro-section {
    padding: 50px 0 80px;
  }

  .cadastro-box {
    max-width: 1000px;
    margin: auto;
    background: #ffffff;
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 4px 24px rgba(0,0,0,.06);
  }

  .cadastro-box-header {
    margin-bottom: 36px;
  }

  .cadastro-box-header h2 {
    margin-bottom: 8px;
  }

  .cadastro-box-header p {
    line-height: 1.6;
  }

  .form-section {
    padding: 30px 0;
    border-top: 1px solid #e5e7eb;
  }

  .form-section:first-of-type {
    border-top: 0;
  }

  .form-section h3 {
    margin-bottom: 22px;
    font-size: 20px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group-full {
    grid-column: 1 / -1;
  }

  .form-group label,
  .upload-box label {
    font-weight: 600;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 13px 14px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font: inherit;
    background: #ffffff;
  }

  .form-group textarea {
    resize: vertical;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #374151;
  }

  .upload-box {
    border: 2px dashed #d1d5db;
    padding: 25px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .upload-box input {
    max-width: 500px;
  }

  .upload-box small {
    opacity: .7;
  }

  .form-actions {
    padding-top: 25px;
    display: flex;
    justify-content: flex-end;
  }

  .btn-submit {
    min-width: 220px;
    padding: 14px 28px;
    font-size: 16px;
  }

  .alert-error {
    margin-bottom: 25px;
    padding: 18px;
    border-radius: 8px;
    background: #fff4f4;
    border: 1px solid #f1b5b5;
  }

  .alert-error ul {
    margin-top: 10px;
    margin-bottom: 0;
  }


  @media (max-width: 768px) {

    .cadastro-box {
      padding: 24px;
    }

    .cadastro-hero {
      padding: 45px 0 35px;
    }

    .cadastro-hero h1 {
      font-size: 32px;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }

    .form-group-full {
      grid-column: auto;
    }

    .btn-submit {
      width: 100%;
    }

  }

</style>


