<%- include('../partials/head', { titulo }) %>

<%- include('../partials/header') %>

<main class="cadastro-page">

  <!-- ====================================================== -->
  <!-- CABEÇALHO -->
  <!-- ====================================================== -->

  <section class="cadastro-hero">
    <div class="container">

      <span class="cadastro-tag">
        UTE Tupã Fase I
      </span>

      <h1>Cadastro de Pessoa Física</h1>

      <p>
        Cadastre seu currículo para oportunidades profissionais
        relacionadas à UTE Tupã Fase I.
      </p>

    </div>
  </section>


  <!-- ====================================================== -->
  <!-- FORMULÁRIO -->
  <!-- ====================================================== -->

  <section class="cadastro-section">

    <div class="container">

      <div class="cadastro-box">

        <div class="cadastro-box-header">

          <h2>Dados do profissional</h2>

          <p>
            Preencha seus dados abaixo. As informações serão utilizadas
            para composição do banco de profissionais da UTE Tupã Fase I.
          </p>

        </div>


        <!-- ERROS -->

        <% if (erros && erros.length > 0) { %>

          <div class="alert alert-error">

            <strong>
              Verifique as informações abaixo:
            </strong>

            <ul>

              <% erros.forEach(function(erro) { %>

                <li>
                  <%= erro.msg %>
                </li>

              <% }) %>

            </ul>

          </div>

        <% } %>


        <form
          action="/cadastro/pessoa-fisica"
          method="POST"
          enctype="multipart/form-data"
          class="cadastro-form"
        >


          <!-- ================================================== -->
          <!-- LOCALIZAÇÃO -->
          <!-- ================================================== -->

          <div class="form-section">

            <h3>Localização</h3>

            <div class="form-grid">

              <div class="form-group">

                <label for="municipio">
                  Município *
                </label>

                <select
                  id="municipio"
                  name="municipio"
                  required
                >

                  <option value="">
                    Selecione
                  </option>

                  <option
                    value="Macaé"
                    <%= valores.municipio === 'Macaé' ? 'selected' : '' %>
                  >
                    Macaé
                  </option>

                  <option
                    value="Rio das Ostras"
                    <%= valores.municipio === 'Rio das Ostras' ? 'selected' : '' %>
                  >
                    Rio das Ostras
                  </option>

                  <option
                    value="Carapebus"
                    <%= valores.municipio === 'Carapebus' ? 'selected' : '' %>
                  >
                    Carapebus
                  </option>

                  <option
                    value="Conceição de Macabu"
                    <%= valores.municipio === 'Conceição de Macabu' ? 'selected' : '' %>
                  >
                    Conceição de Macabu
                  </option>

                  <option
                    value="Casimiro de Abreu"
                    <%= valores.municipio === 'Casimiro de Abreu' ? 'selected' : '' %>
                  >
                    Casimiro de Abreu
                  </option>

                  <option
                    value="Outro"
                    <%= valores.municipio === 'Outro' ? 'selected' : '' %>
                  >
                    Outro município
                  </option>

                </select>

              </div>


              <div
                class="form-group"
                id="municipio-outro-container"
                style="display:none;"
              >

                <label for="municipio_outro">
                  Informe o município *
                </label>

                <input
                  type="text"
                  id="municipio_outro"
                  name="municipio_outro"
                  value="<%= valores.municipio_outro || '' %>"
                >

              </div>

            </div>

          </div>


          <!-- ================================================== -->
          <!-- DADOS PESSOAIS -->
          <!-- ================================================== -->

          <div class="form-section">

            <h3>Dados pessoais</h3>

            <div class="form-grid">

              <div class="form-group form-group-full">

                <label for="nome">
                  Nome completo *
                </label>

                <input
                  type="text"
                  id="nome"
                  name="nome"
                  value="<%= valores.nome || '' %>"
                  required
                >

              </div>


              <div class="form-group">

                <label for="cpf">
                  CPF *
                </label>

                <input
                  type="text"
                  id="cpf"
                  name="cpf"
                  maxlength="14"
                  placeholder="000.000.000-00"
                  value="<%= valores.cpf || '' %>"
                  required
                >

              </div>


              <div class="form-group">

                <label for="sexo">
                  Sexo
                </label>

                <select
                  id="sexo"
                  name="sexo"
                >

                  <option value="">
                    Selecione
                  </option>

                  <option
                    value="Feminino"
                    <%= valores.sexo === 'Feminino' ? 'selected' : '' %>
                  >
                    Feminino
                  </option>

                  <option
                    value="Masculino"
                    <%= valores.sexo === 'Masculino' ? 'selected' : '' %>
                  >
                    Masculino
                  </option>

                  <option
                    value="Outro"
                    <%= valores.sexo === 'Outro' ? 'selected' : '' %>
                  >
                    Outro
                  </option>

                  <option
                    value="Prefiro não informar"
                    <%= valores.sexo === 'Prefiro não informar' ? 'selected' : '' %>
                  >
                    Prefiro não informar
                  </option>

                </select>

              </div>


              <div class="form-group">

                <label for="cep">
                  CEP
                </label>

                <input
                  type="text"
                  id="cep"
                  name="cep"
                  maxlength="9"
                  placeholder="00000-000"
                  value="<%= valores.cep || '' %>"
                >

              </div>


              <div class="form-group form-group-full">

                <label for="endereco">
                  Endereço
                </label>

                <input
                  type="text"
                  id="endereco"
                  name="endereco"
                  placeholder="Rua, avenida, número e bairro"
                  value="<%= valores.endereco || '' %>"
                >

              </div>


              <div class="form-group form-group-full">

                <label for="complemento">
                  Complemento
                </label>

                <input
                  type="text"
                  id="complemento"
                  name="complemento"
                  placeholder="Apartamento, bloco, referência etc."
                  value="<%= valores.complemento || '' %>"
                >

              </div>

            </div>

          </div>


          <!-- ================================================== -->
          <!-- CONTATO -->
          <!-- ================================================== -->

          <div class="form-section">

            <h3>Contato</h3>

            <div class="form-grid">

              <div class="form-group">

                <label for="telefone">
                  Telefone principal *
                </label>

                <input
                  type="tel"
                  id="telefone"
                  name="telefone"
                  placeholder="(00) 00000-0000"
                  value="<%= valores.telefone || '' %>"
                  required
                >

              </div>


              <div class="form-group">

                <label for="telefone_secundario">
                  Segundo telefone
                </label>

                <input
                  type="tel"
                  id="telefone_secundario"
                  name="telefone_secundario"
                  placeholder="(00) 00000-0000"
                  value="<%= valores.telefone_secundario || '' %>"
                >

              </div>


              <div class="form-group form-group-full">

                <label for="email">
                  E-mail *
                </label>

                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="seuemail@exemplo.com"
                  value="<%= valores.email || '' %>"
                  required
                >

              </div>

            </div>

          </div>


