<!-- COMPORTAMENTO DOS CAMPOS -->
<!-- ========================================================== -->

<script>

  // MUNICÍPIO

  const municipio =
    document.getElementById('municipio');

  const municipioOutroContainer =
    document.getElementById(
      'municipio-outro-container'
    );

  const municipioOutro =
    document.getElementById(
      'municipio_outro'
    );


  function atualizarMunicipio() {

    if (
      municipio.value === 'Outro'
    ) {

      municipioOutroContainer.style.display =
        'flex';

      municipioOutro.required =
        true;

    } else {

      municipioOutroContainer.style.display =
        'none';

      municipioOutro.required =
        false;

      municipioOutro.value =
        '';

    }

  }


  municipio.addEventListener(
    'change',
    atualizarMunicipio
  );


  atualizarMunicipio();



  // PROFISSÃO

  const profissao =
    document.getElementById(
      'profissao'
    );

  const outraProfissaoContainer =
    document.getElementById(
      'outra-profissao-container'
    );

  const outraProfissao =
    document.getElementById(
      'outra_profissao'
    );


  function atualizarProfissao() {

    if (
      profissao.value === 'Outros'
    ) {

      outraProfissaoContainer.style.display =
        'flex';

      outraProfissao.required =
        true;

    } else {

      outraProfissaoContainer.style.display =
        'none';

      outraProfissao.required =
        false;

      outraProfissao.value =
        '';

    }

  }


  profissao.addEventListener(
    'change',
    atualizarProfissao
  );


  atualizarProfissao();



  // MÁSCARA CPF

  const cpf =
    document.getElementById('cpf');


  cpf.addEventListener(
    'input',
    function () {

      let valor =
        this.value.replace(/\D/g, '');

      valor =
        valor.substring(0, 11);

      if (valor.length > 9) {

        valor =
          valor.replace(
            /(\d{3})(\d{3})(\d{3})(\d{1,2})/,
            '$1.$2.$3-$4'
          );

      } else if (
        valor.length > 6
      ) {

        valor =
          valor.replace(
            /(\d{3})(\d{3})(\d+)/,
            '$1.$2.$3'
          );

      } else if (
        valor.length > 3
      ) {

        valor =
          valor.replace(
            /(\d{3})(\d+)/,
            '$1.$2'
          );

      }

      this.value =
        valor;

    }
  );



  // MÁSCARA CEP

  const cep =
    document.getElementById('cep');


  cep.addEventListener(
    'input',
    function () {

      let valor =
        this.value.replace(/\D/g, '');

      valor =
        valor.substring(0, 8);

      if (
        valor.length > 5
      ) {

        valor =
          valor.replace(
            /(\d{5})(\d+)/,
            '$1-$2'
          );

      }

      this.value =
        valor;

    }
  );



  // MÁSCARA TELEFONE

  function mascaraTelefone(
    elemento
  ) {

    elemento.addEventListener(
      'input',
      function () {

        let valor =
          this.value.replace(/\D/g, '');

        valor =
          valor.substring(0, 11);

        if (
          valor.length > 10
        ) {

          valor =
            valor.replace(
              /(\d{2})(\d{5})(\d{4})/,
              '($1) $2-$3'
            );

        } else if (
          valor.length > 6
        ) {

          valor =
            valor.replace(
              /(\d{2})(\d{4})(\d{0,4})/,
              '($1) $2-$3'
            );

        } else if (
          valor.length > 2
        ) {

          valor =
            valor.replace(
              /(\d{2})(\d+)/,
              '($1) $2'
            );

        }

        this.value =
          valor;

      }
    );

  }


  mascaraTelefone(
    document.getElementById(
      'telefone'
    )
  );


  mascaraTelefone(
    document.getElementById(
      'telefone_secundario'
    )
  );

// REMOVER CURRÍCULO SELECIONADO

const curriculo =
  document.getElementById('curriculo');

const arquivoSelecionado =
  document.getElementById('arquivo-selecionado');

const nomeArquivo =
  document.getElementById('nome-arquivo');

const removerArquivo =
  document.getElementById('remover-arquivo');


curriculo.addEventListener(
  'change',
  function () {

    if (
      this.files &&
      this.files.length > 0
    ) {

      nomeArquivo.textContent =
        this.files[0].name;

      arquivoSelecionado.style.display =
        'flex';

    } else {

      nomeArquivo.textContent =
        '';

      arquivoSelecionado.style.display =
        'none';

    }

  }
);


removerArquivo.addEventListener(
  'click',
  function () {

    curriculo.value = '';

    nomeArquivo.textContent = '';

    arquivoSelecionado.style.display =
      'none';

  }
);

</script>


