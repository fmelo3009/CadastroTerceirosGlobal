<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="protocolo-box reticle">
      <div class="eyebrow" style="justify-content:center;display:flex;">Cadastro recebido</div>
      <h1>Obrigado, <%= nome %>!</h1>
      <p style="color:var(--concrete-600);max-width:520px;margin:0 auto;">
        Seu cadastro foi recebido com sucesso e está com situação <strong>Pendente de análise</strong>.
        <% if (empreendimentoAtual) { %>Ele foi vinculado ao empreendimento <strong><%= empreendimentoAtual.nome %></strong>.<% } %>
        Guarde o número de protocolo abaixo para eventuais contatos futuros.
      </p>
      <div class="protocolo-numero">Nº <%= String(protocolo).padStart(6, '0') %></div>
      <div>
        <a href="/" class="btn btn-outline-dark">Voltar ao início</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
</body>
</html>
