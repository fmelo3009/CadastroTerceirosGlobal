<%- include('../partials/head', { titulo }) %>

<%- include('../partials/header') %>

<main class="admin-page">

  <section class="admin-hero">

    <div class="container">

      <span class="admin-tag">
        UTE Tupã Fase I
      </span>

      <h1>Painel Administrativo</h1>

      <p>
        Consulte e gerencie os cadastros de profissionais
        e empresas registrados para a UTE Tupã Fase I.
      </p>

    </div>

  </section>


  <section class="admin-section">

    <div class="container">

      <div class="admin-grid">

        <!-- PESSOA FÍSICA -->

        <a
          href="/interno/pessoas-fisicas"
          class="admin-card"
        >

          <div class="admin-icon">
            👤
          </div>

          <div>

            <h2>
              Pessoas Físicas
            </h2>

            <p>
              Consulte profissionais cadastrados,
              currículos, profissões e dados de contato.
            </p>

            <span class="admin-link">
              Acessar cadastros →
            </span>

          </div>

        </a>


        <!-- PESSOA JURÍDICA -->

        <a
          href="/interno/pessoas-juridicas"
          class="admin-card"
        >

          <div class="admin-icon">
            🏢
          </div>

          <div>

            <h2>
              Pessoas Jurídicas
            </h2>

            <p>
              Consulte empresas cadastradas,
              setores de atuação, contatos e portfólios.
            </p>

            <span class="admin-link">
              Acessar cadastros →
            </span>

          </div>

        </a>

      </div>

    </div>

  </section>

</main>


<style>

  .admin-page {
    min-height: 70vh;
    background: #f5f7fa;
  }

  .admin-hero {
    padding: 60px 0 45px;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .admin-tag {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .admin-hero h1 {
    margin: 10px 0 12px;
    font-size: 40px;
  }

  .admin-hero p {
    max-width: 700px;
    font-size: 18px;
    line-height: 1.6;
  }

  .admin-section {
    padding: 55px 0 80px;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 1000px;
    margin: auto;
  }

  .admin-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;

    padding: 32px;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 16px;

    text-decoration: none;
    color: inherit;

    box-shadow: 0 4px 18px rgba(0,0,0,.05);

    transition:
      transform .2s ease,
      box-shadow .2s ease;
  }

  .admin-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 28px rgba(0,0,0,.09);
  }

  .admin-icon {
    width: 58px;
    height: 58px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 28px;

    background: #f3f4f6;

    flex-shrink: 0;
  }

  .admin-card h2 {
    margin: 0 0 10px;
    font-size: 24px;
  }

  .admin-card p {
    margin: 0 0 18px;
    line-height: 1.6;
    opacity: .8;
  }

  .admin-link {
    font-weight: 700;
  }

  @media (max-width: 768px) {

    .admin-grid {
      grid-template-columns: 1fr;
    }

    .admin-hero h1 {
      font-size: 32px;
    }

    .admin-card {
      padding: 24px;
    }

  }

</style>


<%- include('../partials/footer') %>
