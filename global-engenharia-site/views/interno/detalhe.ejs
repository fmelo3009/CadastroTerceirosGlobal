<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/interno-topbar') %>

<div class="admin-page">
  <div class="container" style="max-width:960px;">
    <a href="/interno" class="admin-back">← Voltar para a lista</a>

    <div class="admin-detalhe-head">
      <div>
        <h1><%= terceirizado.nome_fantasia || terceirizado.razao_social %></h1>
        <p style="color:var(--concrete-600);font-size:14px;">
          <%= terceirizado.tipo %> · <%= terceirizado.cpf_cnpj %> · Cadastrado em <%= new Date(terceirizado.criado_em).toLocaleDateString('pt-BR') %>
        </p>
      </div>
      <form class="status-form" method="POST" action="/interno/terceirizados/<%= terceirizado.id %>/situacao">
        <select name="situacao">
          <% situacoes.forEach(function(s) { %>
            <option value="<%= s %>" <%= terceirizado.situacao_cadastral === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <button type="submit" class="btn btn-primary" style="padding:10px 18px;font-size:13.5px;">Atualizar situação</button>
      </form>
    </div>

    <div class="card" style="margin-bottom:24px;">
      <h3 style="margin-bottom:16px;">Dados cadastrais</h3>
      <dl class="info-grid">
        <div><dt>Razão social / Nome</dt><dd><%= terceirizado.razao_social %></dd></div>
        <div><dt>Nome fantasia</dt><dd><%= terceirizado.nome_fantasia || '—' %></dd></div>
        <div><dt>Empreendimento</dt><dd><%= terceirizado.empreendimentoNome %></dd></div>
        <div><dt>CPF/CNPJ</dt><dd><%= terceirizado.cpf_cnpj %></dd></div>
        <div><dt>Inscrição estadual</dt><dd><%= terceirizado.inscricao_estadual || '—' %></dd></div>
        <div><dt>Inscrição municipal</dt><dd><%= terceirizado.inscricao_municipal || '—' %></dd></div>
        <div><dt>Telefone</dt><dd><%= terceirizado.telefone || '—' %></dd></div>
        <div><dt>Telefone (2ª opção)</dt><dd><%= terceirizado.whatsapp || '—' %></dd></div>
        <div><dt>E-mail</dt><dd><%= terceirizado.email || '—' %></dd></div>
        <div><dt>Endereço</dt><dd><%= terceirizado.endereco || '—' %> <%= terceirizado.complemento || '' %></dd></div>
        <div><dt>CEP</dt><dd><%= terceirizado.cep || '—' %></dd></div>
        <div><dt>Cidade/UF</dt><dd><%= terceirizado.cidade %>/<%= terceirizado.estado %></dd></div>
        <div><dt>Contato</dt><dd><%= terceirizado.contato_nome || '—' %> <% if (terceirizado.contato_telefone) { %>· <%= terceirizado.contato_telefone %><% } %></dd></div>
        <div><dt>Setor da atividade</dt><dd><%= terceirizado.setor_atividade || '—' %></dd></div>
      </dl>
      <% if (terceirizado.observacoes) { %>
        <dl class="info-grid" style="margin-top:12px;">
          <div style="grid-column:1/-1;"><dt>Observações</dt><dd><%= terceirizado.observacoes %></dd></div>
        </dl>
      <% } %>
    </div>

    <div class="card" style="margin-bottom:24px;">
      <h3 style="margin-bottom:14px;">Serviços oferecidos</h3>
      <% if (servicos.length) { %>
        <div>
          <% servicos.forEach(function(nome) { %><span class="chip"><%= nome %></span><% }) %>
        </div>
      <% } else { %>
        <p style="color:var(--concrete-600);margin:0;">Nenhum serviço informado.</p>
      <% } %>
    </div>

    <% if (experiencia) { %>
      <div class="card" style="margin-bottom:24px;">
        <h3 style="margin-bottom:16px;">Experiência profissional</h3>
        <dl class="info-grid">
          <div><dt>Tempo de experiência</dt><dd><%= experiencia.tempo_experiencia || '—' %></dd></div>
          <div><dt>Área de atuação</dt><dd><%= experiencia.area_atuacao || '—' %></dd></div>
        </dl>
        <dl class="info-grid" style="margin-top:12px;">
          <% if (experiencia.principais_atividades) { %><div style="grid-column:1/-1;"><dt>Principais atividades</dt><dd><%= experiencia.principais_atividades %></dd></div><% } %>
          <% if (experiencia.empresas_projetos_anteriores) { %><div style="grid-column:1/-1;"><dt>Empresas/projetos anteriores</dt><dd><%= experiencia.empresas_projetos_anteriores %></dd></div><% } %>
          <% if (experiencia.principais_competencias) { %><div style="grid-column:1/-1;"><dt>Principais competências</dt><dd><%= experiencia.principais_competencias %></dd></div><% } %>
          <% if (experiencia.certificacoes) { %><div style="grid-column:1/-1;"><dt>Certificações</dt><dd><%= experiencia.certificacoes %></dd></div><% } %>
        </dl>
      </div>
    <% } %>

    <div class="card">
      <h3 style="margin-bottom:16px;">Documentos</h3>
      <% if (documentos.length === 0) { %>
        <p style="color:var(--concrete-600);margin:0;">Nenhum documento registrado.</p>
      <% } else { %>
        <div class="doc-list">
          <% documentos.forEach(function(doc) { %>
            <div class="doc-item">
              <div>
                <div class="doc-nome"><%= doc.tipo_documento %></div>
                <div class="doc-meta">
                  Status: <%= doc.status %><% if (doc.data_validade) { %> · Validade: <%= doc.data_validade %><% } %>
                  <% if (doc.nome_arquivo_original) { %> · <%= doc.nome_arquivo_original %><% } %>
                </div>
              </div>
              <% if (doc.caminho_arquivo) { %>
                <a href="/interno/documentos/<%= doc.id %>/download" class="btn btn-outline-dark" style="padding:8px 16px;font-size:12.5px;">Baixar arquivo</a>
              <% } else { %>
                <span class="chip-mais">Sem arquivo anexado</span>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

</body>
</html>
