<!DOCTYPE html>
<html lang="pt-BR">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/interno-topbar') %>

<div class="admin-page">
  <div class="container">
    <div class="admin-page-head">
      <div>
        <h1>Terceirizados cadastrados</h1>
        <p>Consulte, filtre e acesse os cadastros enviados pelo site público.</p>
      </div>
      <span class="admin-count-badge"><%= total %> resultado<%= total === 1 ? '' : 's' %></span>
    </div>

    <form class="filter-form" method="GET" action="/interno">
      <div class="field">
        <label for="f-empreendimento">Empreendimento</label>
        <select id="f-empreendimento" name="empreendimento">
          <option value="">Todos</option>
          <% empreendimentos.forEach(function(emp) { %>
            <option value="<%= emp.slug %>" <%= filtros.empreendimento === emp.slug ? 'selected' : '' %>><%= emp.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-servico">Serviço</label>
        <select id="f-servico" name="servico">
          <option value="">Todos</option>
          <% servicosCatalogo.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= String(filtros.servico) === String(s.id) ? 'selected' : '' %>><%= s.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label for="f-cidade">Cidade</label>
        <input type="text" id="f-cidade" name="cidade" value="<%= filtros.cidade %>" placeholder="Ex: Salvador" />
      </div>
      <div class="field">
        <label for="f-situacao">Situação</label>
        <select id="f-situacao" name="situacao">
          <option value="">Todas</option>
          <% situacoes.forEach(function(s) { %>
            <option value="<%= s %>" <%= filtros.situacao === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="field" style="display:flex;gap:10px;">
        <button type="submit" class="btn btn-primary" style="padding:11px 18px;font-size:13.5px;">Filtrar</button>
        <a href="/interno" class="btn btn-outline-dark" style="padding:11px 18px;font-size:13.5px;">Limpar</a>
      </div>
    </form>

    <div class="table-wrap">
      <% if (terceirizados.length === 0) { %>
        <div class="empty-state">Nenhum terceirizado encontrado com esses filtros.</div>
      <% } else { %>
        <table class="table-admin">
          <thead>
            <tr>
              <th>Nome / Razão social</th>
              <th>Empreendimento</th>
              <th>Cidade/UF</th>
              <th>Serviços</th>
              <th>Situação</th>
              <th>Cadastro</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% terceirizados.forEach(function(t) { %>
              <tr>
                <td class="nome-cell">
                  <strong><%= t.nome_fantasia || t.razao_social %></strong>
                  <span><%= t.tipo %> · <%= t.cpf_cnpj %></span>
                </td>
                <td><%= t.empreendimentoNome %></td>
                <td><%= t.cidade %>/<%= t.estado %></td>
                <td>
                  <% t.servicosNomes.slice(0, 2).forEach(function(nome) { %>
                    <span class="chip"><%= nome %></span>
                  <% }) %>
                  <% if (t.servicosNomes.length > 2) { %>
                    <span class="chip-mais">+<%= t.servicosNomes.length - 2 %></span>
                  <% } %>
                  <% if (t.servicosNomes.length === 0) { %><span class="chip-mais">—</span><% } %>
                </td>
                <td>
                  <% var statusClasse = { 'Pendente de análise': 'status-pendente', 'Ativo': 'status-ativo', 'Inativo': 'status-inativo', 'Bloqueado': 'status-bloqueado' }[t.situacao_cadastral] || 'status-pendente'; %>
                  <span class="status-pill <%= statusClasse %>"><%= t.situacao_cadastral %></span>
                </td>
                <td><%= new Date(t.criado_em).toLocaleDateString('pt-BR') %></td>
                <td><a href="/interno/terceirizados/<%= t.id %>" class="btn btn-outline-dark" style="padding:7px 13px;font-size:12.5px;">Ver detalhes</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

</body>
</html>
