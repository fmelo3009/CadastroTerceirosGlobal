<header class="site-header">

  <div class="container header-container">

    <!-- MARCA / LOGO -->
    <a href="/" class="brand">

      <img
        src="/img/logo-SJE.png"
        alt="SJE - São João Energia"
        class="brand-logo"
      />

      <span class="brand-text">

        <strong>
          UTE Tupã Fase I
        </strong>

        <small>
          CADASTRO DE PROFISSIONAIS E EMPRESAS
        </small>

      </span>

    </a>


    <!-- MENU DESKTOP -->
    <nav
      class="nav-desktop"
      aria-label="Navegação principal"
    >

      <a
        href="/#cadastro"
        class="nav-cadastro"
      >
        Cadastro
      </a>

      <a href="/#sobre-tupa">
        Sobre a Tupã
      </a>

      <a href="/#valores">
        Valores
      </a>

      <a href="/#mulheres-tupa">
        Mulheres na Tupã
      </a>

    </nav>


    <!-- BOTÃO MOBILE -->
    <button
      class="hamburger"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>


  <!-- MENU MOBILE -->
  <nav
    class="nav-mobile"
    aria-label="Navegação mobile"
  >

    <a
      href="/#cadastro"
      class="mobile-cadastro"
    >
      Cadastro
    </a>

    <a href="/#sobre-tupa">
      Sobre a Tupã
    </a>

    <a href="/#valores">
      Valores
    </a>

    <a href="/#mulheres-tupa">
      Mulheres na Tupã
    </a>

  </nav>

</header>


<style>

/* ============================================================
   HEADER
============================================================ */

.site-header {
  position: relative;

  width: 100%;

  background: #ffffff;

  border-bottom:
    1px solid #e6ebf1;

  z-index: 1000;
}


.header-container {
  min-height: 82px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 35px;
}


/* ============================================================
   MARCA
============================================================ */

.brand {
  display: flex;

  align-items: center;

  gap: 16px;

  min-width: 0;

  text-decoration: none;
}


.brand-logo {
  display: block;

  width: auto;

  height: 50px;

  max-width: 170px;

  object-fit: contain;

  flex-shrink: 0;
}


.brand-text {
  display: flex;

  flex-direction: column;

  justify-content: center;

  min-width: 0;

  line-height: 1;
}


.brand-text strong {
  color: #073b7a;

  font-size: 21px;

  font-weight: 700;

  line-height: 1.15;

  white-space: nowrap;
}


.brand-text small {
  margin-top: 5px;

  color: #263a52;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: 0.7px;

  line-height: 1.2;

  white-space: nowrap;
}


/* ============================================================
   MENU DESKTOP
============================================================ */

.nav-desktop {
  display: flex;

  align-items: center;

  justify-content: flex-end;

  gap: 8px;

  margin-left: auto;
}


.nav-desktop a {
  position: relative;

  display: flex;

  align-items: center;

  justify-content: center;

  min-height: 44px;

  padding:
    0 17px;

  color: #18344f;

  font-size: 14px;

  font-weight: 500;

  text-decoration: none;

  border-radius: 6px;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}


.nav-desktop a:hover {
  color: #073b7a;

  background: #f4f7fb;
}


/* ============================================================
   CADASTRO EM DESTAQUE
============================================================ */

.nav-desktop .nav-cadastro {
  padding:
    0 23px;

  background: #073b7a;

  color: #ffffff;

  font-weight: 600;
}


.nav-desktop .nav-cadastro:hover {
  background: #052f61;

  color: #ffffff;
}


/* ============================================================
   MENU MOBILE
============================================================ */

.hamburger {
  display: none;

  width: 42px;
  height: 42px;

  padding: 8px;

  background: transparent;

  border: none;

  cursor: pointer;
}


.hamburger span {
  display: block;

  width: 24px;
  height: 2px;

  margin: 5px auto;

  background: #073b7a;

  border-radius: 3px;
}


.nav-mobile {
  display: none;

  padding:
    10px 20px 20px;

  background: #ffffff;

  border-top:
    1px solid #edf0f4;
}


.nav-mobile a {
  display: block;

  padding:
    13px 15px;

  color: #18344f;

  font-size: 14px;

  font-weight: 500;

  text-decoration: none;

  border-radius: 6px;
}


.nav-mobile a:hover {
  background: #f4f7fb;

  color: #073b7a;
}


.nav-mobile .mobile-cadastro {
  margin-bottom: 5px;

  background: #073b7a;

  color: #ffffff;

  font-weight: 600;
}


.nav-mobile .mobile-cadastro:hover {
  background: #052f61;

  color: #ffffff;
}


/* ============================================================
   RESPONSIVIDADE
============================================================ */

@media (max-width: 1050px) {

  .header-container {
    min-height: 76px;
  }


  .brand-logo {
    height: 44px;

    max-width: 145px;
  }


  .brand-text strong {
    font-size: 18px;
  }


  .brand-text small {
    font-size: 9px;
  }


  .nav-desktop a {
    padding:
      0 11px;

    font-size: 13px;
  }

}


@media (max-width: 850px) {

  .header-container {
    min-height: 72px;
  }


  .nav-desktop {
    display: none;
  }


  .hamburger {
    display: block;

    margin-left: auto;
  }


  .nav-mobile.aberto {
    display: block;
  }

}


@media (max-width: 520px) {

  .brand {
    gap: 10px;
  }


  .brand-logo {
    height: 38px;

    max-width: 115px;
  }


  .brand-text strong {
    font-size: 16px;
  }


  .brand-text small {
    max-width: 175px;

    font-size: 8px;

    white-space: normal;
  }

}

</style>


<script>

document.addEventListener(
  'DOMContentLoaded',
  function () {

    const botao =
      document.querySelector(
        '.hamburger'
      );

    const menu =
      document.querySelector(
        '.nav-mobile'
      );


    if (!botao || !menu) {
      return;
    }


    botao.addEventListener(
      'click',
      function () {

        const aberto =
          menu.classList.toggle(
            'aberto'
          );


        botao.setAttribute(
          'aria-expanded',
          aberto
            ? 'true'
            : 'false'
        );

      }
    );


    const links =
      menu.querySelectorAll(
        'a'
      );


    links.forEach(
      function (link) {

        link.addEventListener(
          'click',
          function () {

            menu.classList.remove(
              'aberto'
            );

            botao.setAttribute(
              'aria-expanded',
              'false'
            );

          }
        );

      }
    );

  }
);

</script>
