<header class="site-header">
  <div class="container header-container">

    <a href="/" class="brand">

      <img
        src="/img/logo-gpe.png"
        alt="Grupo Global · GPE"
        class="brand-logo"
      />

      <div class="brand-text">
        <strong>UTE Tupã Fase I</strong>
        <small>Cadastro de Profissionais e Empresas</small>
      </div>

    </a>


    <nav
      class="nav-desktop"
      aria-label="Navegação principal"
    >

      <a
        href="/"
        class="<%= caminhoAtual === '/' ? 'ativo' : '' %>"
      >
        Início
      </a>

      <a href="/#sobre-tupa">
        Sobre a Tupã
      </a>

      <a href="/#cadastro">
        Cadastro
      </a>

      <a href="/#mulheres-tupa">
        Mulheres na Tupã
      </a>

    </nav>


    <button
      class="hamburger"
      aria-label="Abrir menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>


  <nav
    class="nav-mobile"
    aria-label="Navegação mobile"
  >

    <a href="/">
      Início
    </a>

    <a href="/#sobre-tupa">
      Sobre a Tupã
    </a>

    <a href="/#cadastro">
      Cadastro
    </a>

    <a href="/#mulheres-tupa">
      Mulheres na Tupã
    </a>

  </nav>
</header>


<style>

.site-header {
  background: #ffffff;
  border-bottom: 1px solid #e6e6e6;
  width: 100%;
}


.header-container {
  min-height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 32px;
}


/* ============================================================
   MARCA
============================================================ */

.brand {
  display: flex;
  align-items: center;

  gap: 14px;

  text-decoration: none;

  flex-shrink: 0;
}


.brand-logo {
  width: auto;
  height: 38px;

  object-fit: contain;

  display: block;
}


.brand-text {
  display: flex;
  flex-direction: column;

  justify-content: center;

  line-height: 1.1;
}


.brand-text strong {
  font-size: 18px;
  font-weight: 700;

  color: #073b7a;

  margin: 0;
}


.brand-text small {
  margin-top: 4px;

  font-size: 10px;
  font-weight: 500;

  text-transform: uppercase;
  letter-spacing: 0.6px;

  color: #354052;

  white-space: nowrap;
}


/* ============================================================
   MENU DESKTOP
============================================================ */

.nav-desktop {
  display: flex;
  align-items: stretch;

  height: 72px;

  gap: 6px;

  margin-left: auto;
}


.nav-desktop a {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 0 22px;

  text-decoration: none;

  color: #152d4f;

  font-size: 14px;
  font-weight: 500;

  text-align: center;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}


.nav-desktop a:hover {
  color: #073b7a;
}


.nav-desktop a::after {
  content: '';

  position: absolute;

  left: 18px;
  right: 18px;
  bottom: 13px;

  height: 2px;

  background: transparent;
}


.nav-desktop a.ativo::after {
  background: #f4a000;
}


.nav-desktop a.ativo {
  color: #073b7a;
}


/* ============================================================
   HAMBURGER
============================================================ */

.hamburger {
  display: none;

  background: none;
  border: none;

  padding: 8px;

  cursor: pointer;
}


.hamburger span {
  display: block;

  width: 24px;
  height: 2px;

  margin: 5px 0;

  background: #073b7a;
}


/* ============================================================
   MOBILE
============================================================ */

.nav-mobile {
  display: none;
}


@media (max-width: 900px) {

  .header-container {
    min-height: 64px;
  }


  .brand-logo {
    height: 32px;
  }


  .brand-text strong {
    font-size: 16px;
  }


  .brand-text small {
    font-size: 9px;
  }


  .nav-desktop {
    display: none;
  }


  .hamburger {
    display: block;
  }


  .nav-mobile {
    display: none;

    flex-direction: column;

    background: #ffffff;

    border-top: 1px solid #eeeeee;

    padding: 12px 20px 18px;
  }


  .nav-mobile a {
    padding: 12px 0;

    text-decoration: none;

    color: #152d4f;

    font-size: 14px;

    border-bottom: 1px solid #f0f0f0;
  }

}


@media (max-width: 520px) {

  .brand-text small {
    white-space: normal;

    max-width: 170px;
  }

}

</style>
